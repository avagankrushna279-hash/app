# Copy to .env and fill in. Never share this file or commit it.

# --- Required ---
DATABASE_URL=
APP_SECRET=

# --- First admin login (created automatically at startup if it does not exist) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI (without a key the WhatsApp agent hands every chat to a person) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
MOCK_LLM=0
LLM_PER_MINUTE=20

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MODE=
GRAPH_VERSION=v21.0
ALERT_TEMPLATE=
ALERT_TEMPLATE_LANG=en
REMINDER_TEMPLATE=
REMINDER_TEMPLATE_LANG=en

# --- Optional ---
PORT=8787
CORS_ORIGIN=*
DATABASE_SSL=0
